<?php

/**
 * @file
 * Limits the CKEditor 5 media library to media in the current group.
 *
 * How it works:
 * 1. GroupMediaLibrary (a replacement for core's CKEditor 5 media library
 *    plugin class) puts the current group ID into the media library's
 *    hash-signed opener parameters when the editor is built.
 * 2. When the media_library view runs inside that dialog, the group ID is
 *    passed along as an extra view argument (so AJAX paging and the exposed
 *    filters keep it), and hook_views_query_alter() limits the results to
 *    media that has a group_media relationship with that group.
 * 3. Media uploaded from the dialog is added to the same group.
 *
 * No changes to the media_library view config are needed.
 */

use Drupal\ckeditor5\Plugin\CKEditor5Plugin\MediaLibrary;
use Drupal\group\Entity\GroupInterface;
use Drupal\media\MediaInterface;
use Drupal\media_library\MediaLibraryState;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\layout_builder\SectionStorageInterface;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;
use Drupal\group_media_editor_filter\Plugin\CKEditor5Plugin\GroupMediaLibrary;

/**
 * Marker prepended to the group ID in the view arguments.
 *
 * Makes our argument easy to tell apart from core's media type argument.
 */
const GROUP_MEDIA_EDITOR_FILTER_ARG_PREFIX = 'group:';

/**
 * Set to FALSE once everything works to stop the debug log messages.
 */
const GROUP_MEDIA_EDITOR_FILTER_DEBUG = TRUE;

/**
 * Writes a debug message to Reports > Recent log messages.
 */
function group_media_editor_filter_debug(string $message, array $context = []): void {
  if (GROUP_MEDIA_EDITOR_FILTER_DEBUG) {
    \Drupal::logger('group_media_editor_filter')->debug($message, $context);
  }
}

/**
 * Implements hook_ckeditor5_plugin_info_alter().
 */
function group_media_editor_filter_ckeditor5_plugin_info_alter(array &$plugin_definitions): void {
  // Core's plugin ID is 'media_library_mediaLibrary'. Match on the class
  // rather than the ID so this keeps working if the ID changes.
  foreach ($plugin_definitions as $definition) {
    if ($definition->getClass() === MediaLibrary::class) {
      $definition->setClass(GroupMediaLibrary::class);
    }
  }
}

/**
 * Works out which group the page being edited belongs to.
 *
 * Covers:
 * - /group/{group}/content/create/... (adding content through the group).
 * - /node/{node}/edit for a node that is in a group.
 * - Layout Builder block forms (add/configure block in the off-canvas tray)
 *   on a node's own layout (an "override"), using the node being laid out.
 *
 * Returns NULL anywhere else, including the default layout for a content
 * type, in which case the media library is left unfiltered.
 */
function group_media_editor_filter_current_group_id(): ?int {
  $route_match = \Drupal::routeMatch();

  group_media_editor_filter_debug('Editor built on route @route.', ['@route' => $route_match->getRouteName()]);

  $group = $route_match->getParameter('group');
  if ($group instanceof GroupInterface) {
    group_media_editor_filter_debug('Group @gid found in the route.', ['@gid' => $group->id()]);
    return (int) $group->id();
  }

  $entity = NULL;

  // Layout Builder: the block forms carry the layout being edited as
  // {section_storage}. For a per-node layout ("overrides") its 'entity'
  // context is the node.
  $section_storage = $route_match->getParameter('section_storage');
  if ($section_storage instanceof SectionStorageInterface) {
    if ($section_storage->getPluginId() === 'overrides') {
      try {
        $entity = $section_storage->getContextValue('entity');
      }
      catch (\Exception $e) {
        $entity = NULL;
      }
    }
    else {
      group_media_editor_filter_debug('Layout Builder storage @type has no single entity (default layout).', ['@type' => $section_storage->getPluginId()]);
    }
  }

  if (!$entity) {
    $entity = $route_match->getParameter('node');
  }

  if ($entity instanceof ContentEntityInterface && !$entity->isNew()) {
    if ($group_id = group_media_editor_filter_entity_group_id($entity)) {
      group_media_editor_filter_debug('@type @id is in group @gid.', [
        '@type' => $entity->getEntityTypeId(),
        '@id' => $entity->id(),
        '@gid' => $group_id,
      ]);
      return $group_id;
    }
    group_media_editor_filter_debug('@type @id is not in any group.', [
      '@type' => $entity->getEntityTypeId(),
      '@id' => $entity->id(),
    ]);
  }

  group_media_editor_filter_debug('No group found for this editor, media library will not be filtered.');
  return NULL;
}

/**
 * Returns the group an entity belongs to, or NULL.
 */
function group_media_editor_filter_entity_group_id(ContentEntityInterface $entity): ?int {
  /** @var \Drupal\group\Entity\Storage\GroupRelationshipStorageInterface $storage */
  $storage = \Drupal::entityTypeManager()->getStorage('group_relationship');
  $relationships = $storage->loadByEntity($entity);
  if (!$relationships) {
    return NULL;
  }
  // If an entity can live in several groups, decide here which one wins.
  return (int) reset($relationships)->getGroupId();
}

/**
 * Reads the group ID from the media library state on the current request.
 *
 * The state is hash-signed by core, so the value can't be tampered with.
 */
function group_media_editor_filter_state_group_id(): ?int {
  try {
    $state = MediaLibraryState::fromRequest(\Drupal::request());
  }
  catch (\Exception $e) {
    // Not a media library request, or no valid state.
    return NULL;
  }
  if ($state->getOpenerId() !== 'media_library.opener.editor') {
    return NULL;
  }
  $group_id = $state->getOpenerParameters()['group_id'] ?? NULL;
  return $group_id ? (int) $group_id : NULL;
}

/**
 * Finds our group ID among a view's arguments.
 */
function group_media_editor_filter_group_id_from_args(array $args): ?int {
  foreach ($args as $arg) {
    if (is_string($arg) && str_starts_with($arg, GROUP_MEDIA_EDITOR_FILTER_ARG_PREFIX)) {
      $id = substr($arg, strlen(GROUP_MEDIA_EDITOR_FILTER_ARG_PREFIX));
      return ctype_digit($id) ? (int) $id : NULL;
    }
  }
  return NULL;
}

/**
 * Checks whether a view display is the media library dialog.
 */
function group_media_editor_filter_is_library_display(ViewExecutable $view, $display_id): bool {
  return $view->id() === 'media_library'
    && in_array($display_id, ['widget', 'widget_table'], TRUE);
}

/**
 * Implements hook_views_pre_view().
 *
 * On the first load of the dialog the group ID comes from the signed state.
 * It is added to the view arguments so it survives AJAX paging, sorting and
 * the exposed filters, which re-run the view with the same arguments.
 */
function group_media_editor_filter_views_pre_view(ViewExecutable $view, $display_id, array &$args): void {
  if (!group_media_editor_filter_is_library_display($view, $display_id)) {
    return;
  }
  if (group_media_editor_filter_group_id_from_args($args) !== NULL) {
    return;
  }
  if ($group_id = group_media_editor_filter_state_group_id()) {
    $args[] = GROUP_MEDIA_EDITOR_FILTER_ARG_PREFIX . $group_id;
    group_media_editor_filter_debug('Media library opened for group @gid.', ['@gid' => $group_id]);
  }
  else {
    group_media_editor_filter_debug('Media library opened without a group ID. Query: @q', ['@q' => \Drupal::request()->getQueryString()]);
  }
}

/**
 * Implements hook_views_query_alter().
 *
 * Keeps only media that is related to the group through a group_media
 * relationship.
 */
function group_media_editor_filter_views_query_alter(ViewExecutable $view, QueryPluginBase $query): void {
  if (!group_media_editor_filter_is_library_display($view, $view->current_display)) {
    return;
  }
  $group_id = group_media_editor_filter_group_id_from_args($view->args);
  if ($group_id === NULL) {
    return;
  }

  /** @var \Drupal\views\Plugin\views\query\Sql $query */
  $subquery = \Drupal::database()->select('group_relationship_field_data', 'gr')
    ->fields('gr', ['entity_id'])
    ->condition('gr.gid', $group_id)
    ->condition('gr.plugin_id', 'group_media:%', 'LIKE');

  $base_table = $view->storage->get('base_table');
  $base_field = $view->storage->get('base_field');
  $query->addWhere(0, "$base_table.$base_field", $subquery, 'IN');
  group_media_editor_filter_debug('Media library filtered to group @gid (display @display).', ['@gid' => $group_id, '@display' => $view->current_display]);
}

/**
 * Implements hook_media_insert().
 *
 * Media uploaded through the editor's media library dialog is added to the
 * group the editor was opened in, so it shows up there next time.
 */
function group_media_editor_filter_media_insert(MediaInterface $media): void {
  $group_id = group_media_editor_filter_state_group_id();
  if (!$group_id) {
    return;
  }

  /** @var \Drupal\group\Entity\GroupInterface|null $group */
  $group = \Drupal::entityTypeManager()->getStorage('group')->load($group_id);
  if (!$group || !$group->getMember(\Drupal::currentUser())) {
    return;
  }

  $plugin_id = 'group_media:' . $media->bundle();
  if (!$group->getGroupType()->hasPlugin($plugin_id)) {
    // This media type isn't enabled on the group type.
    return;
  }

  $group->addRelationship($media, $plugin_id);
}
