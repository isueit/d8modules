<?php

use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\Core\Site\Settings;
use Drupal\node\Entity\Node;
use Drupal\taxonomy\Entity\Term;

/**
 * Implements hook_cron().
 */
function smartsheet_api_cron()
{
  $config = \Drupal::config('smartsheet_api.settings');
  $last_sync = \Drupal::state()->get('smartsheet_api.last_sync', 0);
  if (\Drupal::time()->getRequestTime() - $last_sync >= $config->get('sync_interval')) {
    smartsheet_api_ptc_sync();
  }
}

/*
 * Smartsheet helpers, usable for any sheet
 */

/**
 * Get the rows from a Smartsheet
 *
 * @param string $sheet_id
 *   Found in Smartsheet under File > Properties
 * @param array $required_columns
 *   Column titles the caller needs. If any are missing (renamed?), nothing is returned.
 *
 * @return array|null
 *   Rows keyed by Smartsheet row ID, each an array of cell values keyed by column title,
 *   or null if the sheet couldn't be read
 */
function smartsheet_api_get_rows(string $sheet_id, array $required_columns = [])
{
  $token = Settings::get('smartsheet_api_token');
  if (empty($token)) {
    \Drupal::logger('smartsheet_api')->warning('Need to put smartsheet_api_token into the settings.php file!');
    return null;
  }

  try {
    $response = \Drupal::httpClient()->get('https://api.smartsheet.com/2.0/sheets/' . $sheet_id, [
      'headers' => [
        'Authorization' => 'Bearer ' . $token,
        'Accept' => 'application/json',
      ],
      'timeout' => 60,
    ]);
    $sheet = json_decode((string) $response->getBody(), true);
  } catch (\Exception $e) {
    \Drupal::logger('smartsheet_api')->error('Could not get Smartsheet ' . $sheet_id . ': ' . $e->getMessage());
    return null;
  }

  if (empty($sheet['columns']) || !isset($sheet['rows'])) {
    \Drupal::logger('smartsheet_api')->error('Smartsheet ' . $sheet_id . ' returned no columns or rows');
    return null;
  }

  // Cells only have a column ID, so map those to the column titles
  $titles = array_column($sheet['columns'], 'title', 'id');
  $missing = array_diff($required_columns, $titles);
  if (!empty($missing)) {
    \Drupal::logger('smartsheet_api')->error('Smartsheet ' . $sheet_id . ' is missing columns, was one renamed? ' . implode(', ', $missing));
    return null;
  }

  $rows = [];
  foreach ($sheet['rows'] as $row) {
    $cells = [];
    foreach ($row['cells'] as $cell) {
      if (array_key_exists($cell['columnId'], $titles)) {
        $value = $cell['value'] ?? '';
        $cells[$titles[$cell['columnId']]] = is_string($value) ? trim($value) : $value;
      }
    }
    $rows[(string) $row['id']] = $cells;
  }

  return $rows;
}

/**
 * Return a Y-m-d date, or an empty string if it isn't one
 */
function smartsheet_api_date($value)
{
  return (is_string($value) && preg_match('/^\d{4}-\d{2}-\d{2}$/', $value)) ? $value : '';
}

/**
 * Return a valid URL, or an empty string
 *
 * Link columns sometimes hold email addresses or room names, and sometimes leave off https://
 */
function smartsheet_api_url(string $value)
{
  if (empty($value) || filter_var($value, FILTER_VALIDATE_EMAIL)) {
    return '';
  }
  if (!preg_match('/^https?:\/\//i', $value)) {
    $value = 'https://' . $value;
  }
  $host = parse_url($value, PHP_URL_HOST);

  return (filter_var($value, FILTER_VALIDATE_URL) && !empty($host) && str_contains($host, '.')) ? $value : '';
}

/**
 * Get the ID of a term, creating it if needed
 */
function smartsheet_api_term_id(string $vid, string $name)
{
  $term_ids = &drupal_static(__FUNCTION__, []);
  if (empty($name)) {
    return null;
  }

  if (!isset($term_ids[$vid][$name])) {
    $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties(['vid' => $vid, 'name' => $name]);
    $term = reset($terms);
    if (!$term) {
      $term = Term::create(['vid' => $vid, 'name' => $name]);
      $term->save();
    }
    $term_ids[$vid][$name] = $term->id();
  }

  return $term_ids[$vid][$name];
}

/*
 * PTC Class Series sync
 */

/**
 * Sync PTC Class Series nodes from the PTC Caregiver Class Series Smartsheet
 *
 * Rows marked "No, thanks" for the website, and classes that have already ended, are left
 * unpublished. Cancelled and postponed classes stay published (with their status) until
 * their original start date passes.
 *
 * @param bool $dry_run
 *   Count what would change, without saving anything
 *
 * @return array|null
 *   Counts of created, updated, unchanged, and unpublished nodes, or null if the sync couldn't run
 */
function smartsheet_api_ptc_sync(bool $dry_run = false)
{
  $lock = \Drupal::lock();
  if (!$lock->acquire('smartsheet_api_ptc_sync', 600)) {
    \Drupal::logger('smartsheet_api')->notice('PTC Class Series sync is already running, skipping');
    return null;
  }

  $config = \Drupal::config('smartsheet_api.settings');
  $rows = smartsheet_api_get_rows($config->get('ptc_sheet_id'), smartsheet_api_ptc_required_columns());
  if ($rows === null) {
    $lock->release('smartsheet_api_ptc_sync');
    return null;
  }

  // If we got fewer rows than expected, something could be wrong with the sheet, so don't
  // risk unpublishing everything
  $minimum_rows = $config->get('ptc_minimum_rows');
  if (count($rows) < $minimum_rows) {
    \Drupal::logger('smartsheet_api')->warning('Expected at least ' . $minimum_rows . ' PTC Class Series rows from Smartsheet, received ' . count($rows) . ' - Something could be wrong, so exiting sync');
    $lock->release('smartsheet_api_ptc_sync');
    return null;
  }

  // Get current nodes, keyed by Smartsheet row ID
  $nodes = [];
  foreach (\Drupal::entityTypeManager()->getStorage('node')->loadByProperties(['type' => 'ptc_class_series']) as $node) {
    if (!empty($node->field_ptc_row_id->value)) {
      $nodes[$node->field_ptc_row_id->value] = $node;
    }
  }

  $summary = ['created' => 0, 'updated' => 0, 'unchanged' => 0, 'unpublished' => 0];
  $today = (new DrupalDateTime('now'))->format('Y-m-d');
  $published_row_ids = [];
  $term_fields = smartsheet_api_ptc_term_fields();

  foreach ($rows as $row_id => $row) {
    if (!smartsheet_api_ptc_should_publish($row, $today)) {
      continue;
    }
    $published_row_ids[$row_id] = true;

    $values = smartsheet_api_ptc_map_row($row);
    $values['title'] = smartsheet_api_ptc_build_title($values);
    $hash = md5(serialize($values));

    // Find the existing node, otherwise create one
    if (array_key_exists($row_id, $nodes)) {
      $node = $nodes[$row_id];
      if ($node->field_ptc_sync_hash->value === $hash && $node->isPublished()) {
        $summary['unchanged']++;
        continue;
      }
      $summary['updated']++;
    } else {
      $node = Node::create(['type' => 'ptc_class_series']);
      $node->set('field_ptc_row_id', $row_id);
      $summary['created']++;
    }

    if ($dry_run) {
      continue;
    }

    try {
      foreach ($values as $field => $value) {
        if (array_key_exists($field, $term_fields)) {
          $value = smartsheet_api_term_id($term_fields[$field], $value);
        }
        $node->set($field, $value);
      }
      $node->set('field_ptc_sync_hash', $hash);
      $node->setPublished();
      $node->setNewRevision();
      $node->setRevisionLogMessage('Synced from Smartsheet');
      $node->save();
    } catch (\Exception $e) {
      \Drupal::logger('smartsheet_api')->error('Could not save PTC Class Series Smartsheet row ' . $row_id . ': ' . $e->getMessage());
    }
  }

  // Unpublish nodes whose rows were removed, or no longer belong on the website
  foreach ($nodes as $row_id => $node) {
    if (!array_key_exists($row_id, $published_row_ids) && $node->isPublished()) {
      $summary['unpublished']++;
      if (!$dry_run) {
        $node->setUnpublished();
        $node->setNewRevision();
        $node->setRevisionLogMessage('Unpublished by Smartsheet sync');
        $node->save();
      }
    }
  }

  if (!$dry_run) {
    \Drupal::state()->set('smartsheet_api.last_sync', \Drupal::time()->getRequestTime());
    \Drupal::logger('smartsheet_api')->info('PTC Class Series sync: @created created, @updated updated, @unchanged unchanged, @unpublished unpublished', [
      '@created' => $summary['created'],
      '@updated' => $summary['updated'],
      '@unchanged' => $summary['unchanged'],
      '@unpublished' => $summary['unpublished'],
    ]);
  }

  $lock->release('smartsheet_api_ptc_sync');
  return $summary;
}

/**
 * Columns the PTC Class Series sync reads. If any of these are renamed in Smartsheet, the sync stops.
 */
function smartsheet_api_ptc_required_columns()
{
  return [
    'Add to PTC Website',
    'Start Date',
    'End Date',
    'Class Series Time',
    'Time Zone',
    'Class Format',
    'Which platform will the virtual class series use?',
    'Is this event open to the general public?',
    'City',
    'State or Province',
    'State write-in option',
    'Country',
    'Is there a fee for class participants?',
    'Fee',
    'Caregiver Class/Workshop Audience',
    'Length',
    'Registration Email',
    'Registration Name',
    'Registration Phone Number',
    'Class Website Link',
    'Class Description',
    'Language',
    'Status of Class Series (CS) Registration',
  ];
}

/**
 * PTC Class Series fields that reference taxonomy terms, and their vocabularies
 */
function smartsheet_api_ptc_term_fields()
{
  return [
    'field_ptc_format' => 'ptc_format',
    'field_ptc_state' => 'ptc_location',
    'field_ptc_audience' => 'ptc_audience',
    'field_ptc_language' => 'ptc_language',
  ];
}

/**
 * Decide whether a PTC Class Series row should be published on the website
 *
 * We don't use the sheet's "Past or Current Class Series" column, it's a TODAY() formula
 * that Smartsheet only recalculates when someone opens the sheet.
 */
function smartsheet_api_ptc_should_publish(array $row, string $today)
{
  // Only exclude rows that have explicitly said no
  if (str_starts_with(strtolower($row['Add to PTC Website'] ?? ''), 'no')) {
    return false;
  }

  $start_date = smartsheet_api_date($row['Start Date'] ?? '');
  $end_date = smartsheet_api_date($row['End Date'] ?? '');

  // Cancelled and postponed classes stay up until their original start date
  $status = smartsheet_api_ptc_status($row['Status of Class Series (CS) Registration'] ?? '');
  if (in_array($status, ['cancelled', 'postponed'])) {
    $last_date = $start_date;
  } else {
    $last_date = !empty($end_date) ? $end_date : $start_date;
  }

  return !empty($last_date) && $last_date >= $today;
}

/**
 * Turn a PTC Class Series row into node field values
 *
 * Term fields hold the term name here, they're turned into term IDs when the node is saved.
 */
function smartsheet_api_ptc_map_row(array $row)
{
  $state = $row['State or Province'] ?? '';
  if ($state == 'Write-in option') {
    $state = $row['State write-in option'] ?? '';
  }

  $fee = '';
  if (($row['Is there a fee for class participants?'] ?? '') == 'Yes') {
    $fee = (string) ($row['Fee'] ?? '');
    if (is_numeric($fee)) {
      $fee = '$' . $fee;
    }
  } elseif (($row['Is there a fee for class participants?'] ?? '') == 'No') {
    $fee = 'None';
  }

  // Registration Email sometimes holds a registration form URL instead of an email
  $registration = (string) ($row['Registration Email'] ?? '');
  $registration_email = filter_var($registration, FILTER_VALIDATE_EMAIL) ? $registration : '';

  return [
    'field_ptc_status' => smartsheet_api_ptc_status($row['Status of Class Series (CS) Registration'] ?? ''),
    'field_ptc_start_date' => smartsheet_api_date($row['Start Date'] ?? ''),
    'field_ptc_end_date' => smartsheet_api_date($row['End Date'] ?? ''),
    'field_ptc_class_time' => (string) ($row['Class Series Time'] ?? ''),
    'field_ptc_time_zone' => (string) ($row['Time Zone'] ?? ''),
    'field_ptc_format' => (string) ($row['Class Format'] ?? ''),
    'field_ptc_platform' => (string) ($row['Which platform will the virtual class series use?'] ?? ''),
    'field_ptc_city' => (string) ($row['City'] ?? ''),
    'field_ptc_state' => (string) $state,
    'field_ptc_country' => (string) ($row['Country'] ?? ''),
    'field_ptc_audience' => (string) ($row['Caregiver Class/Workshop Audience'] ?? ''),
    'field_ptc_length' => (string) ($row['Length'] ?? ''),
    'field_ptc_language' => (string) ($row['Language'] ?? ''),
    'field_ptc_fee' => $fee,
    'field_ptc_open_to_public' => ($row['Is this event open to the general public?'] ?? '') == 'Yes',
    'field_ptc_reg_name' => (string) ($row['Registration Name'] ?? ''),
    'field_ptc_reg_email' => $registration_email,
    'field_ptc_reg_phone' => (string) ($row['Registration Phone Number'] ?? ''),
    'field_ptc_reg_link' => empty($registration_email) ? smartsheet_api_url($registration) : '',
    'field_ptc_class_link' => smartsheet_api_url((string) ($row['Class Website Link'] ?? '')),
    'field_ptc_description' => (string) ($row['Class Description'] ?? ''),
  ];
}

/**
 * Build the PTC Class Series node title
 *
 * ex: Powerful Tools for Caregivers – In Person, St. Cloud, Minnesota (January 19, 2027) [Caregivers of Adults]
 */
function smartsheet_api_ptc_build_title(array $values)
{
  $title = 'Powerful Tools for Caregivers';
  if (!empty($values['field_ptc_format'])) {
    $title .= ' – ' . $values['field_ptc_format'];
  }
  $place = implode(', ', array_filter([$values['field_ptc_city'], $values['field_ptc_state']]));
  if ($values['field_ptc_format'] != 'Virtual' && !empty($place)) {
    $title .= ', ' . $place;
  }
  if (!empty($values['field_ptc_start_date'])) {
    $title .= ' (' . date('F j, Y', strtotime($values['field_ptc_start_date'])) . ')';
  }
  if (!empty($values['field_ptc_audience'])) {
    $title .= ' [' . $values['field_ptc_audience'] . ']';
  }

  return mb_substr($title, 0, 255);
}

/**
 * Map the Smartsheet registration status to the field_ptc_status key
 */
function smartsheet_api_ptc_status(string $value)
{
  $value = strtolower($value);
  if (str_starts_with($value, 'postponed') || $value == 'cancelled/postponed') {
    return 'postponed';
  }
  if (str_starts_with($value, 'cancel')) {
    return 'cancelled';
  }
  if (str_starts_with($value, 'at capacity')) {
    return 'at_capacity';
  }
  if (str_starts_with($value, 'space available')) {
    return 'space_available';
  }
  return null;
}
