{#
  Group navigation menu.

  Renders each item with the theme's own menu_item macro from
  menu--main.html.twig, so group menus get the same markup (and the same
  click-to-open dropdown behavior) as the main menu, then appends a
  "Register" link when registration is currently open.

  Extra variables supplied by regcytes_preprocess_menu__group_menu():
    - registration_is_open: TRUE when today is between the open and close dates.
    - registration_url:     Resolved URL string for the registration link.
#}
{% import '@iastate_theme/navigation/menu--main.html.twig' as menus %}

{% if items or registration_is_open %}
  <ul {{ attributes.addClass('nav navbar-nav menubar group-menu') }}>
    {% for item in items %}
      {{ menus.menu_item(item, 0) }}
    {% endfor %}

    {% if registration_is_open %}
      <li class="nav-item register-nav-item">
        <a class="nav-link isu-nav-link" href="{{ registration_url }}">Register</a>
      </li>
    {% endif %}
  </ul>
{% endif %}
