<table>
  <tr>
    {% for item in headers %}
      <th style="padding: 0;">{{ item }}</th>
    {% endfor %}
    {% for key, value in topics %}
      <tr>
        <td style="padding: 0;">{{ key }}</td>
        {% for item in value %}
          <td style="padding: 0;">{{ item }}</td>
        {% endfor %}
      </tr>
    {% endfor %}
  </tr>
</table>
