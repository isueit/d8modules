{#
/**
 * @file
 * Markup for the Porkbot chat widget toggle and panel.
 *
 * Available variables:
 * - module_path: Path to the porkbot module, relative to the site root.
 */
#}
<button id="porkbot-toggle" class="porkbot-toggle" type="button" aria-label="{{ 'Open Iowa State University Extension and Outreach Porkbot'|t }}" aria-controls="porkbot-widget" aria-expanded="false">
  <img src="{{ base_path ~ module_path }}/assets/PorkChatBot-02.png" alt="" width="44" height="44" />
</button>

<section id="porkbot-widget" class="porkbot-widget is-hidden" aria-label="{{ 'Iowa State University Extension and Outreach Porkbot'|t }}">
  <header class="porkbot-header">
    <div class="porkbot-title">
      <img src="{{ base_path ~ module_path }}/assets/porky-icon-left.png" alt="" width="34" height="34" />
      <div>
        <h2>{{ 'Porkbot'|t }}</h2>
      </div>
    </div>
    <button id="porkbot-close" class="porkbot-close" type="button" aria-label="{{ 'Close Iowa State University Extension and Outreach Porkbot'|t }}">X</button>
  </header>
  <div id="porkbot-status" class="porkbot-status" role="status" hidden></div>
  <div id="porkbot-webchat" class="porkbot-webchat" role="region" aria-label="{{ 'Conversation'|t }}"></div>
</section>
